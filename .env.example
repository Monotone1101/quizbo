# Copy to .env at the repo root. Every app (web, battle, worker) and Prisma read this one file locally;
# on a hosting platform set the same variables in its dashboard instead.

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local: `npm run db:local` starts a Prisma Postgres dev server and prints a postgres:// URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quizbo"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))")
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Google sign-in (optional). Callback URL: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email magic-link sign-in via Resend (optional)
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Quizbo <login@example.com>"
# Demo sign-in with just a display name. Handy locally and for previews; turn off for a real launch.
AUTH_DEMO_LOGIN=true

# ── Battle service (Socket.io) ──────────────────────────────────────────────
# Shared secret: the web app signs short-lived battle tokens, the battle service verifies them.
BATTLE_JWT_SECRET=""
# Where browsers reach the battle service.
NEXT_PUBLIC_BATTLE_URL="http://localhost:4000"
# Origins allowed to open sockets (comma-separated).
WEB_ORIGIN="http://localhost:3000"
# Port for the battle service (platforms usually inject PORT instead).
BATTLE_PORT=4000

# ── Gemini (Google AI Studio) ───────────────────────────────────────────────
# Free key: https://aistudio.google.com/apikey — on the free tier Google may use prompts and responses
# to improve its products, so switch to a paid key before real students use it (see DEPLOY.md).
# Without a key the app still runs: extraction/coach show an offline state and analysis uses a template.
GEMINI_API_KEY=""
QUIZBO_GEMINI_MODEL="gemini-3.8-flash"

# ── Redis (worker only: BullMQ nightly jobs) ────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Media ───────────────────────────────────────────────────────────────────
# Self-host the ASCII fists loop before launch (see DEPLOY.md). Defaults point at the client-provided files.
NEXT_PUBLIC_FISTS_VIDEO_URL=""
NEXT_PUBLIC_FISTS_POSTER_URL=""
